{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe build project",
            "command": "D:\\Program Files\\w64devkit\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${workspaceFolder}\\main.cpp",
